{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TinyWMS teaching EventBridge bus and rules for OrderPlaced domain events",
  "Parameters": {
    "EventBusName": {
      "Type": "String",
      "Default": "tinywms-events",
      "Description": "Name of the teaching event bus"
    }
  },
  "Resources": {
    "TinyWmsEventBus": {
      "Type": "AWS::Events::EventBus",
      "Properties": {
        "Name": { "Ref": "EventBusName" }
      }
    },
    "ShippingRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "tinywms-orderplaced-shipping",
        "EventBusName": { "Ref": "TinyWmsEventBus" },
        "EventPattern": {
          "source": ["tinywms.orders"],
          "detail-type": ["OrderPlaced"]
        },
        "State": "ENABLED"
      }
    },
    "AuditRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "tinywms-orderplaced-audit",
        "EventBusName": { "Ref": "TinyWmsEventBus" },
        "EventPattern": {
          "source": ["tinywms.orders"],
          "detail-type": ["OrderPlaced"]
        },
        "State": "ENABLED"
      }
    }
  },
  "Outputs": {
    "EventBusName": {
      "Description": "Event bus name used by TinyWMS to publish OrderPlaced events",
      "Value": { "Ref": "TinyWmsEventBus" }
    },
    "ShippingRuleName": {
      "Description": "Example shipping consumer rule name",
      "Value": { "Ref": "ShippingRule" }
    },
    "AuditRuleName": {
      "Description": "Example audit consumer rule name",
      "Value": { "Ref": "AuditRule" }
    }
  }
}
