{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TinyWMS teaching SQS queue for asynchronous pick work",
  "Resources": {
    "TinyWmsPickWorkQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "tinywms-pick-work",
        "VisibilityTimeout": 30,
        "MessageRetentionPeriod": 345600
      }
    }
  },
  "Outputs": {
    "QueueUrl": {
      "Description": "URL used by TinyWMS to send pick-work JSON messages",
      "Value": { "Ref": "TinyWmsPickWorkQueue" }
    },
    "QueueArn": {
      "Description": "ARN of the TinyWMS pick-work queue",
      "Value": { "Fn::GetAtt": ["TinyWmsPickWorkQueue", "Arn"] }
    }
  }
}
