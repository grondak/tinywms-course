{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TinyWMS reproducible AWS deployment for API Gateway, Lambda, RDS, SQS, EventBridge, IAM, and logging",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String",
      "Description": "S3 bucket holding the packaged Lambda zip artifact"
    },
    "LambdaCodeS3Key": {
      "Type": "String",
      "Description": "S3 key of the packaged Lambda zip artifact"
    },
    "DatabaseName": {
      "Type": "String",
      "Default": "tinywms",
      "Description": "TinyWMS database name"
    },
    "DatabaseUser": {
      "Type": "String",
      "NoEcho": true,
      "Description": "TinyWMS database user"
    },
    "DatabasePassword": {
      "Type": "String",
      "NoEcho": true,
      "Description": "TinyWMS database password"
    },
    "DbInstanceClass": {
      "Type": "String",
      "Default": "db.t3.micro",
      "Description": "Small RDS instance class for teaching"
    },
    "ApiStageName": {
      "Type": "String",
      "Default": "prod",
      "Description": "API Gateway deployment stage name"
    },
    "EventBusName": {
      "Type": "String",
      "Default": "tinywms-events",
      "Description": "EventBridge bus name for OrderPlaced events"
    },
    "LambdaLogRetentionDays": {
      "Type": "Number",
      "Default": 7,
      "Description": "CloudWatch log retention in days"
    }
  },
  "Resources": {
    "TinyWmsVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [
          { "Key": "Name", "Value": "tinywms-vpc" }
        ]
      }
    },
    "TinyWmsPrivateSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "TinyWmsVpc" },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": { "Fn::Select": [0, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          { "Key": "Name", "Value": "tinywms-private-a" }
        ]
      }
    },
    "TinyWmsPrivateSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "TinyWmsVpc" },
        "CidrBlock": "10.42.2.0/24",
        "AvailabilityZone": { "Fn::Select": [1, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          { "Key": "Name", "Value": "tinywms-private-b" }
        ]
      }
    },
    "TinyWmsDbSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "TinyWMS private subnets for RDS",
        "SubnetIds": [
          { "Ref": "TinyWmsPrivateSubnetA" },
          { "Ref": "TinyWmsPrivateSubnetB" }
        ]
      }
    },
    "TinyWmsLambdaSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "TinyWMS Lambda outbound access to RDS",
        "VpcId": { "Ref": "TinyWmsVpc" },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "TinyWmsDatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "TinyWMS RDS inbound from Lambda only",
        "VpcId": { "Ref": "TinyWmsVpc" },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": { "Ref": "TinyWmsLambdaSecurityGroup" }
          }
        ]
      }
    },
    "TinyWmsDatabase": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Delete",
      "Properties": {
        "AllocatedStorage": "20",
        "DBInstanceClass": { "Ref": "DbInstanceClass" },
        "DBName": { "Ref": "DatabaseName" },
        "Engine": "postgres",
        "MasterUsername": { "Ref": "DatabaseUser" },
        "MasterUserPassword": { "Ref": "DatabasePassword" },
        "DBSubnetGroupName": { "Ref": "TinyWmsDbSubnetGroup" },
        "VPCSecurityGroups": [
          { "Ref": "TinyWmsDatabaseSecurityGroup" }
        ],
        "BackupRetentionPeriod": 1,
        "PubliclyAccessible": false,
        "StorageType": "gp2",
        "MultiAZ": false,
        "DeletionProtection": false
      }
    },
    "TinyWmsPickWorkQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": { "Fn::Sub": "${AWS::StackName}-pick-work" },
        "VisibilityTimeout": 30,
        "MessageRetentionPeriod": 345600
      }
    },
    "TinyWmsEventBus": {
      "Type": "AWS::Events::EventBus",
      "Properties": {
        "Name": { "Ref": "EventBusName" }
      }
    },
    "TinyWmsLambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Fn::Sub": "${AWS::StackName}-lambda-role" },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": ["lambda.amazonaws.com"]
              },
              "Action": ["sts:AssumeRole"]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
          "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "tinywms-sqs-and-events",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": { "Fn::GetAtt": ["TinyWmsPickWorkQueue", "Arn"] }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "events:PutEvents"
                  ],
                  "Resource": { "Fn::GetAtt": ["TinyWmsEventBus", "Arn"] }
                }
              ]
            }
          }
        ]
      }
    },
    "TinyWmsLambdaLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-inventory-rds" },
        "RetentionInDays": { "Ref": "LambdaLogRetentionDays" }
      }
    },
    "TinyWmsInventoryFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-inventory-rds" },
        "Runtime": "python3.12",
        "Handler": "src/lambda_inventory.handler",
        "Role": { "Fn::GetAtt": ["TinyWmsLambdaExecutionRole", "Arn"] },
        "Timeout": 15,
        "MemorySize": 256,
        "VpcConfig": {
          "SecurityGroupIds": [
            { "Ref": "TinyWmsLambdaSecurityGroup" }
          ],
          "SubnetIds": [
            { "Ref": "TinyWmsPrivateSubnetA" },
            { "Ref": "TinyWmsPrivateSubnetB" }
          ]
        },
        "Environment": {
          "Variables": {
            "TINYWMS_DB_HOST": { "Fn::GetAtt": ["TinyWmsDatabase", "Endpoint.Address"] },
            "TINYWMS_DB_PORT": { "Fn::GetAtt": ["TinyWmsDatabase", "Endpoint.Port"] },
            "TINYWMS_DB_NAME": { "Ref": "DatabaseName" },
            "TINYWMS_DB_USER": { "Ref": "DatabaseUser" },
            "TINYWMS_DB_PASSWORD": { "Ref": "DatabasePassword" },
            "TINYWMS_SQS_QUEUE_URL": { "Ref": "TinyWmsPickWorkQueue" },
            "TINYWMS_EVENT_BUS_NAME": { "Ref": "TinyWmsEventBus" }
          }
        },
        "Code": {
          "S3Bucket": { "Ref": "ArtifactBucket" },
          "S3Key": { "Ref": "LambdaCodeS3Key" }
        }
      },
      "DependsOn": ["TinyWmsLambdaLogGroup"]
    },
    "TinyWmsInventoryApi": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": { "Fn::Sub": "${AWS::StackName}-api" }
      }
    },
    "TinyWmsInventoryResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ParentId": { "Fn::GetAtt": ["TinyWmsInventoryApi", "RootResourceId"] },
        "PathPart": "inventory"
      }
    },
    "TinyWmsOrdersResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ParentId": { "Fn::GetAtt": ["TinyWmsInventoryApi", "RootResourceId"] },
        "PathPart": "orders"
      }
    },
    "TinyWmsInventoryGetMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ResourceId": { "Ref": "TinyWmsInventoryResource" },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${TinyWmsInventoryFunction.Arn}/invocations"
          }
        }
      }
    },
    "TinyWmsOrdersPostMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ResourceId": { "Ref": "TinyWmsOrdersResource" },
        "HttpMethod": "POST",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${TinyWmsInventoryFunction.Arn}/invocations"
          }
        }
      }
    },
    "TinyWmsApiDeployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "DependsOn": [
        "TinyWmsInventoryGetMethod",
        "TinyWmsOrdersPostMethod"
      ],
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "Description": "TinyWMS lesson deployment"
      }
    },
    "TinyWmsApiStage": {
      "Type": "AWS::ApiGateway::Stage",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "DeploymentId": { "Ref": "TinyWmsApiDeployment" },
        "StageName": { "Ref": "ApiStageName" },
        "MethodSettings": [
          {
            "DataTraceEnabled": true,
            "HttpMethod": "*",
            "LoggingLevel": "INFO",
            "MetricsEnabled": true,
            "ResourcePath": "/*"
          }
        ]
      }
    },
    "TinyWmsInventoryPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": { "Ref": "TinyWmsInventoryFunction" },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${TinyWmsInventoryApi}/*/*/*"
        }
      }
    },
    "ShippingRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": { "Fn::Sub": "${AWS::StackName}-orderplaced-shipping" },
        "EventBusName": { "Ref": "TinyWmsEventBus" },
        "EventPattern": {
          "source": ["tinywms.orders"],
          "detail-type": ["OrderPlaced"]
        },
        "State": "ENABLED"
      }
    },
    "AuditRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": { "Fn::Sub": "${AWS::StackName}-orderplaced-audit" },
        "EventBusName": { "Ref": "TinyWmsEventBus" },
        "EventPattern": {
          "source": ["tinywms.orders"],
          "detail-type": ["OrderPlaced"]
        },
        "State": "ENABLED"
      }
    }
  },
  "Outputs": {
    "ApiBaseUrl": {
      "Description": "Base URL for the deployed TinyWMS API",
      "Value": {
        "Fn::Sub": "https://${TinyWmsInventoryApi}.execute-api.${AWS::Region}.amazonaws.com/${ApiStageName}"
      }
    },
    "PickWorkQueueUrl": {
      "Description": "SQS queue URL used by Lambda and optional Raspberry Pi workers",
      "Value": { "Ref": "TinyWmsPickWorkQueue" }
    },
    "PickWorkQueueArn": {
      "Description": "SQS queue ARN",
      "Value": { "Fn::GetAtt": ["TinyWmsPickWorkQueue", "Arn"] }
    },
    "EventBusName": {
      "Description": "EventBridge bus name for OrderPlaced",
      "Value": { "Ref": "TinyWmsEventBus" }
    },
    "DbEndpointAddress": {
      "Description": "RDS endpoint address",
      "Value": { "Fn::GetAtt": ["TinyWmsDatabase", "Endpoint.Address"] }
    },
    "DbEndpointPort": {
      "Description": "RDS endpoint port",
      "Value": { "Fn::GetAtt": ["TinyWmsDatabase", "Endpoint.Port"] }
    },
    "DatabaseName": {
      "Description": "Database name",
      "Value": { "Ref": "DatabaseName" }
    },
    "DatabaseUser": {
      "Description": "Database user",
      "Value": { "Ref": "DatabaseUser" }
    },
    "LambdaFunctionName": {
      "Description": "Lambda function name",
      "Value": { "Ref": "TinyWmsInventoryFunction" }
    }
  }
}
