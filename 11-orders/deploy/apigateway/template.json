{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TinyWMS API Gateway in front of Lambda inventory and orders",
  "Resources": {
    "TinyWmsInventoryApi": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": "tinywms-inventory-api"
      }
    },
    "TinyWmsInventoryResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ParentId": { "Fn::GetAtt": ["TinyWmsInventoryApi", "RootResourceId"] },
        "PathPart": "inventory"
      }
    },
    "TinyWmsOrdersResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ParentId": { "Fn::GetAtt": ["TinyWmsInventoryApi", "RootResourceId"] },
        "PathPart": "orders"
      }
    },
    "TinyWmsInventoryGetMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ResourceId": { "Ref": "TinyWmsInventoryResource" },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${TinyWmsInventoryFunction.Arn}/invocations"
          }
        }
      }
    },
    "TinyWmsOrdersPostMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": { "Ref": "TinyWmsInventoryApi" },
        "ResourceId": { "Ref": "TinyWmsOrdersResource" },
        "HttpMethod": "POST",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${TinyWmsInventoryFunction.Arn}/invocations"
          }
        }
      }
    },
    "TinyWmsInventoryPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": { "Ref": "TinyWmsInventoryFunction" },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com"
      }
    }
  }
}
